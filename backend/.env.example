# .env template for ExpenseFlow backend
# Copy this to .env and fill in your values

# MySQL Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/expenseflow

# App Settings
APP_ENV=development
APP_DEBUG=True
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

# LLM API Key for "Ask AI" feature of grok
LLM_API_KEY=your-api-key-here
